<!DOCTYPE html>
<html>
<head>
    <title>Blog Platform</title>
</head>
<body>
    <h1>Blog Posts</h1>

    <a href="/new">Create New Post</a>

    <% posts.forEach(post => { %>
        <hr>
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>

        <a href="/post/<%= post._id %>">View</a>
        <a href="/delete/<%= post._id %>">Delete</a>
    <% }) %>
</body>
</html>
