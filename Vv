<!DOCTYPE html>
<html>
<head>
    <title><%= post.title %></title>
</head>
<body>

    <h1><%= post.title %></h1>
    <p><%= post.content %></p>

    <h2>Comments</h2>

    <ul>
        <% post.comments.forEach(comment => { %>
            <li><%= comment %></li>
        <% }) %>
    </ul>

    <form action="/comment/<%= post._id %>" method="POST">
        <input type="text" name="comment" placeholder="Write a comment" required>
        <button type="submit">Add Comment</button>
    </form>

    <br>
    <a href="/">Back</a>

</body>
</html>
